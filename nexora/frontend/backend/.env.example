NODE_ENV=development
PORT=5000
TRUST_PROXY=false
SESSION_COOKIE_NAME=nexora_session
SESSION_TTL_DAYS=14

# Local MongoDB connection. Use a credentialed URI if authentication is enabled.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=nexora
MONGODB_CONNECT_TIMEOUT=10000

# Only used by `npm run migrate:mysql-to-mongo` to import the old MySQL database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexora
DB_USER=root
DB_PASSWORD=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=debug

# Optional: set both values to create an initial administrator during `npm run seed`.
# The seed password must be at least 12 characters.
SEED_ADMIN_EMAIL=leta76365@gmail.com
SEED_ADMIN_PASSWORD=Leta211219@#
SEED_ADMIN_NAME=Leta Tesfaye

# Optional AI integration settings.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=

# Optional transactional email provider.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173

# Optional private file storage directory.
STORAGE_DIRECTORY=